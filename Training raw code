# -*- coding: utf-8 -*-

"""
Point at a directory of per-cell-type CSVs, get a correlation matrix and heatmap.

Each file becomes one value per gene, those are ranked into
percentiles, and the cell types are Spearman-correlated against each other.

Labels come from the filenames.

Writes <outdir>/<name>_corr.tsv and <outdir>/<name>.png

Usage:
    python corr_heatmap.py --dir ~/path/to/prediction/csvs --name predictions
"""

import argparse
import re
from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt

FEATURE_RE = re.compile(r"^feature_\d+$")
ID_COLS = {"gene_name", "chromo", "gene", "chr", "chromosome", "name"}


def label(path):
  return re.sub(r"[_-]?(predictions|merged)$", "", path.stem, flags=re.I)


def profile(path):
    """One percentile per gene, whichever file type this is."""
    cols = pd.read_csv(path, nrows=0).columns.tolist()

    if any(FEATURE_RE.match(c) for c in cols):
        # merged file: identifier column plus a single value column
        value = [c for c in cols
                 if not FEATURE_RE.match(c) and c.lower() not in ID_COLS]
        if len(value) != 1:
            raise SystemExit(f"{path.name}: expected one value column, "
                             f"found {value}")
        gene = next((c for c in cols if c.lower() in ID_COLS), cols[0])
        s = pd.read_csv(path, usecols=[gene, value[0]])
        s = s.drop_duplicates(subset=gene).set_index(gene)[value[0]]
    else:
        # predictions file: genes as rows, individuals as columns
        df = pd.read_csv(path, index_col=0)
        s = df.mean(axis=1)

    s.index = s.index.astype(str).str.split(".").str[0]
    s = s[~s.index.duplicated(keep="first")]
    return s.astype(float).rank(pct=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dir", required=True, help="Directory of per-cell-type CSVs.")
    ap.add_argument("--name", required=True, help="Output file stem.")
    ap.add_argument("--title", default=None, help="Plot title.")
    ap.add_argument("--outdir", default=".")
    ap.add_argument("--pattern", default="*.csv")
    ap.add_argument("--vmin", type=float, default=None,
                    help="Colour scale minimum. Pass the same value on two "
                         "runs to make the heatmaps comparable.")
    args = ap.parse_args()

    files = sorted(Path(args.dir).glob(args.pattern))
    if len(files) < 2:
        raise SystemExit(f"Need at least two files; found {len(files)} in {args.dir}")

    profiles = {}
    for f in files:
        profiles[label(f)] = profile(f)
        print(f"{label(f):<36} {len(profiles[label(f)]):,} genes")

    mat = pd.DataFrame(profiles).dropna()
    print(f"\nGenes shared by all {len(profiles)} cell types: {len(mat):,}")
    if mat.empty:
        raise SystemExit("No genes shared across all files.")

    corr = mat.rank(pct=True).corr(method="spearman")

    outdir = Path(args.outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    corr.to_csv(outdir / f"{args.name}_corr.tsv", sep="\t")

    off = corr.to_numpy()[~np.eye(len(corr), dtype=bool)]
    print(f"Off-diagonal Spearman: min {off.min():.3f}  "
          f"median {np.median(off):.3f}  max {off.max():.3f}")

    vmin = args.vmin if args.vmin is not None else np.floor(off.min() * 20) / 20
    n = len(corr)
    fig, ax = plt.subplots(figsize=(3 + 0.3 * n, 3 + 0.26 * n))
    im = ax.imshow(corr.to_numpy(), cmap="viridis", vmin=vmin, vmax=1.0)
    ax.set_xticks(range(n)); ax.set_yticks(range(n))
    ax.set_xticklabels(corr.columns, rotation=90, fontsize=9)
    ax.set_yticklabels(corr.index, fontsize=9)
    ax.set_title(args.title or args.name, loc="left", fontweight="bold")
    fig.colorbar(im, ax=ax, fraction=0.046, label="Spearman rho")
    fig.tight_layout()
    fig.savefig(outdir / f"{args.name}.png", dpi=300, bbox_inches="tight")

    print(f"\nWrote {outdir / (args.name + '_corr.tsv')}")
    print(f"Wrote {outdir / (args.name + '.png')}")
    if args.vmin is None:
        print(f"(colour scale {vmin:.2f}-1.00; pass --vmin {vmin:.2f} "
              f"on another run to match)")


if __name__ == "__main__":
    main()

