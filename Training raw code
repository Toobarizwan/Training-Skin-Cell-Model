# Load HSCA extended - everything including core
HSCA_extended_obj <- readRDS("HSCA_extended.rds")
str(HSCA_extended_obj)

# Confusion: why are both core and extended same size
# Check cell counts in each
ncol(HSCA_core_obj)          #293827 cells
ncol(HSCA_extended_obj)      #821464 cells
dim(HSCA_core_obj)           #dim() returns genes x cells --> 35299 x 293827

# Check gene counts
nrow(HSCA_core_obj)          #35299 genes
nrow(HSCA_extended_obj)      #48481 genes
dim(HSCA_extended_obj)

# Exploring data

# look at the overall structure
# This tells you what slots/data are inside the object
str(HSCA_extended_obj, max.level = 4)  
# max.level=2 prevents it from printing too much

# What metadata columns exist?
# This shows all the info stored per cell
colnames(HSCA_extended_obj@meta.data)

# View first few rows of metadata
head(HSCA_extended_obj@meta.data)

# See all unique datasets with cell counts
table(HSCA_extended_obj@meta.data$Dataset)

# See all unique anatomical sites with cell counts
table(HSCA_extended_obj@meta.data$anatomical_region_level3)

#random
table(HSCA_extended_obj@graphs)

# To see cluster sizes
table(Idents(HSCA_extended_obj))

# Count cells per cell type
# Level 1 - broadest cell type groups
# This shows the main categories
table(HSCA_extended_obj@meta.data$celltype_lvl_1_extended)

# Level 2 - more specific
table(HSCA_extended_obj@meta.data$celltype_lvl_2_extended)

# Level 3 - even more specific
table(HSCA_extended_obj@meta.data$celltype_lvl_3_extended)

# Level 4 - even more specific
table(HSCA_extended_obj@meta.data$celltype_lvl_4_extended)

# Level 5 - even more specific
table(HSCA_extended_obj@meta.data$celltype_lvl_5_extended)


# View the raw counts matrix
# GetAssayData pulls the actual numbers from the RNA assay
GetAssayData(HSCA_extended_obj, assay = "RNA", layer = "counts")[1:30, 1:30]     #shows genes x cells

# Q. Why do I get so many zeros in raw cell matrix?
# There is sparsity in single cell data.
# Any given cell only uses a small fraction of its 48,481 genes at any one time.
# A skin keratinocyte actively uses maybe 3,000-5,000 genes at once.
# The other 43,000+ genes = 0 = dots
# Raw counts means how many RNA molecules from that gene were captured and sequenced in that cell.

# To see cell types for those 10 cells
cells <- colnames(GetAssayData(HSCA_extended_obj))[1:10]
HSCA_extended_obj@meta.data[cells, "celltype_lvl_3_extended"]

# What is the range of counts per cell?
# (how many total RNA molecules captured per cell)
summary(HSCA_extended_obj@meta.data$nCount_RNA)

# What is the range of genes detected per cell?
# (how many genes had at least 1 count)
summary(HSCA_extended_obj@meta.data$nFeature_RNA)

# What fraction of the matrix is zero?
# (sparsity)
library(Matrix)
mat <- GetAssayData(HSCA_extended_obj, assay = "RNA", layer = "counts")
sparsity <- 1 - (nnzero(mat) / length(mat))
cat("Sparsity:", round(sparsity * 100, 2), "%\n")    # Sparsity: 95.52 %































