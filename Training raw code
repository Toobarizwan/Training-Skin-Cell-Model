#Loop to find 0 var genes in all cell types
cat > /home/tooba/Skin_Cell_Model/check_flat_genes.R << 'EOF'
suppressMessages(library(tools))

pred_dir <- "/home/tooba/Skin_Cell_Model/predictions"
files <- list.files(pred_dir, pattern = "_predictions\\.csv$", full.names = TRUE)

results <- data.frame(cell_type = character(), total_genes = integer(),
                       flat_genes = integer(), percent_flat = numeric(),
                       stringsAsFactors = FALSE)

for (f in files) {
  cell_type <- sub("_predictions\\.csv$", "", basename(f))
  df <- read.csv(f, row.names = 1, check.names = FALSE)

  # Detect orientation: genes are columns if column names look like ENSG IDs
  if (grepl("^ENSG", colnames(df)[1])) {
    variances <- apply(df, 2, var, na.rm = TRUE)  # genes = columns
  } else {
    variances <- apply(df, 1, var, na.rm = TRUE)  # genes = rows
  }

  total <- length(variances)
  flat <- sum(variances == 0, na.rm = TRUE)
  pct <- round(100 * flat / total, 2)

  results <- rbind(results, data.frame(cell_type = cell_type, total_genes = total,
                                        flat_genes = flat, percent_flat = pct))
  cat(cell_type, ":", flat, "/", total, "(", pct, "%)\n")
}

write.csv(results, "/home/tooba/Skin_Cell_Model/flat_genes_summary.csv", row.names = FALSE)
cat("\nSaved summary to flat_genes_summary.csv\n")
EOF

